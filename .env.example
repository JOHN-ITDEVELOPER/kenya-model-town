# Firebase Project Configuration (Supports with or without VITE_ prefix on Vercel / Netlify)
# Get these values from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Admin Google Email (the account allowed to access Challenge Creator, Dashboard & Admin tools)
VITE_ADMIN_EMAIL=your_email@gmail.com

# ==============================================================================
# PHASE 2: SERVER-SIDE M-PESA DARAJA & FIREBASE ADMIN CREDENTIALS
# (Keep strictly in .env locally & Vercel Environment Variables - NEVER prefix with VITE_)
# ==============================================================================

# 'sandbox' for testing, 'production' when you go live with your PayBill/Till
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=your_daraja_consumer_key
DARAJA_CONSUMER_SECRET=your_daraja_consumer_secret
DARAJA_PASSKEY=your_daraja_lipa_na_mpesa_online_passkey
DARAJA_SHORTCODE=174379
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# Optional for CustomerBuyGoodsOnline (Till Number): set Store/HO ShortCode above and Till as PartyB
# DARAJA_PARTY_B=

# Public HTTPS callback URL (Optional on Vercel prod; required when testing locally via ngrok)
# DARAJA_CALLBACK_URL=https://your-app.vercel.app/api/mpesa/callback
# Optional secret appended to callback URL for extra verification
# DARAJA_CALLBACK_SECRET=choose_a_random_alphanumeric_secret

# Firebase Service Account JSON (single-line JSON or base64 string)
# Generate from Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT_JSON=

# Alternative to FIREBASE_SERVICE_ACCOUNT_JSON (you can set individual fields instead):
# FIREBASE_ADMIN_PROJECT_ID=your_project_id
# FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
